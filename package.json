{
  "name": "mandelbrot-view",
  "version": "2.0.0",
  "description": "Mandelbrot/Julia explorer running the desktop C++ core compiled to WebAssembly",
  "type": "module",
  "license": "MIT",
  "author": "xiaoxu4452",
  "homepage": "https://xiaoxu4452.github.io/mandelbrot-view/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoxu4452/mandelbrot-view.git"
  },
  "scripts": {
    "page": "node server/static-server.mjs",
    "build:core": "node webcore/build.mjs",
    "sync:src": "node webcore/sync-src.mjs",
    "test:core": "node webcore/test.mjs",
    "test:view": "node webcore/test-view.mjs",
    "test:families": "node tools/_families-check.mjs",
    "test:preset-zoom": "node tools/_preset-zoom-check.mjs",
    "build:formula": "node formulacore/build.mjs",
    "test:formula": "node formulacore/test.mjs",
    "test:formula-jet": "node formulacore/general-test.mjs",
    "test:formula-perturb": "node formulacore/perturb-test.mjs",
    "test:formula-bands": "node formulacore/bands-test.mjs",
    "smoke": "node tools/_shell-smoke.mjs",
    "bump": "node tools/_bump-cache.mjs",
    "publish": "node tools/_publish.mjs",
    "test:formula-align": "node formulacore/align-test.mjs",
    "test:formula-ui": "node tools/_formula-ui-check.mjs",
    "test:formula-deep": "node tools/_formula-deep-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
